{
  "name": "@comline/runtime",
  "version": "0.1.0",
  "description": "TypeScript runtime that Comline-generated RPC bindings link against.",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "imports": {
    "#core/comline.mjs": "./core/comline.mjs"
  },
  "files": [
    "dist",
    "src",
    "core"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js dist/test/prop/*.test.js",
    "typecheck:generated": "tsc -p tsconfig.generated.json --erasableSyntaxOnly"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.6.0"
  }
}
