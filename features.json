{
  "features": [
    {
      "description": "`struct` declarations",
      "id": "structs",
      "title": "structs"
    },
    {
      "description": "`enum` declarations",
      "id": "enums",
      "title": "enums"
    },
    {
      "description": "fields marked `optional`",
      "id": "optional-fields",
      "title": "optional fields"
    },
    {
      "description": "variable-length arrays, `T[]`",
      "id": "arrays",
      "title": "arrays"
    },
    {
      "description": "fixed-length arrays, `T[N]`",
      "id": "fixed-arrays",
      "title": "fixed-length arrays"
    },
    {
      "description": "a `T[N]` with N over 32 anywhere but a field's own, non-optional type: inside another array, optional, an alias, an argument or a return",
      "id": "large-fixed-arrays-nested",
      "title": "fixed arrays over 32 elements, nested"
    },
    {
      "description": "`union(A B ...)` types",
      "id": "unions",
      "title": "unions"
    },
    {
      "description": "`type Name = ...` declarations",
      "id": "type-aliases",
      "title": "type aliases"
    },
    {
      "description": "`const` declarations",
      "id": "constants",
      "title": "constants"
    },
    {
      "description": "`protocol` declarations and their functions",
      "id": "protocols",
      "title": "protocols"
    },
    {
      "description": "`error` declarations",
      "id": "errors",
      "title": "errors"
    },
    {
      "description": "functions declared with `! Error`",
      "id": "throws",
      "title": "functions that throw"
    },
    {
      "description": "`@validators` on fields and type aliases, checked in generated code",
      "id": "validators",
      "title": "validators"
    },
    {
      "description": "`use` of another schema's declarations",
      "id": "imports",
      "title": "imports between schemas"
    },
    {
      "description": "schemas in subdirectories (`chat::admin`)",
      "id": "nested-namespaces",
      "title": "nested namespaces"
    },
    {
      "description": "`--mode lib`: a buildable package, not bare source files",
      "id": "lib-mode",
      "title": "`lib` mode"
    },
    {
      "description": "`[generate] external_std`: `std` referenced as its own package",
      "id": "external-std",
      "title": "`external_std`"
    },
    {
      "description": "`[generate] validate_on_decode`: decoding runs the checks",
      "id": "validate-on-decode",
      "title": "`validate_on_decode`"
    },
    {
      "description": "`@framing = \"jsonrpc\"` (or as the package default)",
      "id": "framing-jsonrpc",
      "title": "JSON-RPC framing"
    },
    {
      "description": "`@handshake = \"none\"` (or as the package default)",
      "id": "handshake-none",
      "title": "no handshake"
    },
    {
      "description": "`@framing = \"datagram@3\"` (or as the package default): calls addressed by wire numbers",
      "id": "framing-datagram3",
      "title": "`datagram@3` framing"
    },
    {
      "description": "`@handshake = \"comline@2\"` (or as the package default): compatibility checked by each version's facts, calls the peer lacks failing locally",
      "id": "handshake-comline2",
      "title": "`comline@2` handshake"
    },
    {
      "description": "protocols on a connection, with calls in both directions: `datagram@3` (the default) or `datagram@2`, or `@provider = Client` / `Multiple`",
      "id": "connections",
      "title": "connections"
    },
    {
      "description": "`[generate] async`: connection protocols get async handlers and senders",
      "id": "async",
      "title": "`async`"
    },
    {
      "description": "`wire.format = \"packed@1\"`, the default: fixed-width fields, no tags",
      "id": "format-packed",
      "title": "the `packed@1` format"
    },
    {
      "description": "`wire.format = \"json@1\"`",
      "id": "format-json",
      "title": "the `json@1` format"
    },
    {
      "description": "`wire.format = \"msgpack@1\"`",
      "id": "format-msgpack",
      "title": "the `msgpack@1` format"
    },
    {
      "description": "a maximum or exact length on a string or list (`char[max 64]`, `char[8]`, `T[max N]`), or a depth limit (`@max_depth`): checked while decoding and encoding",
      "id": "bounds",
      "title": "bounds"
    },
    {
      "description": "`char`: one Unicode scalar value",
      "id": "chars",
      "title": "single characters"
    }
  ],
